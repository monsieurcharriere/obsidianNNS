{
  "name": "obsidian-nns",
  "version": "0.1.0",
  "description": "Render Nashville Number System charts (ChordText) in Obsidian and export them as PDF.",
  "main": "main.js",
  "private": true,
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "tsc --noEmit --skipLibCheck && node esbuild.config.mjs production",
    "test": "vitest run"
  },
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^20.0.0",
    "builtin-modules": "^3.3.0",
    "esbuild": "^0.28.1",
    "obsidian": "latest",
    "tslib": "^2.6.2",
    "typescript": "^5.4.5",
    "vitest": "^4.1.0"
  }
}
